# Copy to .env and fill in:  cp .env.example .env
# Values already exported in your shell take precedence over this file.

# --- LLM gateway (Soket / TensorStudio LiteLLM proxy, OpenAI-compatible) ---
# In-cluster NodePort of llm-logging/litellm-proxy (any Ready node IP works),
# or the public endpoint https://api.tensorstudio.ai/v1
SOKET_BASE_URL=http://<node-ip>:31184/v1
SOKET_API_KEY=sk-...

# --- Web search for personas with allow_web_search (optional) ---
# Without it those personas simply run without the tool.
TAVILY_API_KEY=tvly-...

# --- Langfuse (trace store) ---
# In-cluster NodePort of llm-logging/langfuse
LANGFUSE_BASE_URL=http://<node-ip>:30395
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Optional generation knobs ---
# CONVGEN_MAX_TOKENS=1024
# CONVGEN_TEMPERATURE=0.8
